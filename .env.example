# OpenAI (LLM, transcrição, visão, voz) — obrigatória
OPENAI_API_KEY=

# Evolution API (sobe junto no docker compose)
# A mesma chave é usada pelo container da Evolution e pelo app.
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCE=autoconf

# Só se a Evolution NÃO for a deste compose (servidor ou nuvem). Veja "WhatsApp com ngrok" no README.
# EVOLUTION_API_URL=https://sua-evolution.exemplo.com
# NGROK_AUTHTOKEN=seu-token-do-ngrok
# WEBHOOK_URL=https://SEU-ENDERECO.ngrok-free.app/webhook/evolution

# Gatilho do agente no WhatsApp
TRIGGER_KEYWORD=#thread
# Modo de teste: TEST=on liga os comandos abaixo no WhatsApp (nunca valem na tela de chat).
#   #reset  arquiva a conversa e começa do zero no mesmo número
#   #parar  o agente para de responder (volta com o gatilho #thread)
TEST=off
RESET_KEYWORD=#reset
STOP_KEYWORD=#parar

# Langfuse: sobe local no compose (http://localhost:3000, admin@autoconf.local / autoconf123).
# Estas chaves são criadas automaticamente no projeto na primeira subida.
# Dentro do compose o app sempre usa http://langfuse-web:3000; LANGFUSE_HOST vale ao rodar fora do Docker.
LANGFUSE_PUBLIC_KEY=pk-lf-autoconf-local
LANGFUSE_SECRET_KEY=sk-lf-autoconf-local
LANGFUSE_HOST=http://localhost:3000

# Modelos e comportamento (opcionais, estes são os padrões)
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
NOME_ATENDENTE=Lia
NOME_LOJA=Autoconf Veículos
AGRUPAR_SEGUNDOS=5
SESSAO_MINUTOS=30
HISTORICO_N=20
